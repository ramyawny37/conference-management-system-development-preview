{
  "outputDirectory": "vercel-public",
  "functions": {
    "api/gateway.js": {
      "includeFiles": "{*.html,*.js,*.css,*.json,assets/**,icons/**,libs/**,js/**}"
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/api/gateway?__platform_path=/" },
    { "source": "/:path*", "destination": "/api/gateway?__platform_path=/:path*" }
  ]
}
